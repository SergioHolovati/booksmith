<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.9</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.booksmith</groupId>
	<artifactId>booksmith-app</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>booksmith-app</name>
	<description>Booksmith: monólito modular (Spring Modulith)</description>

	<properties>
		<java.version>25</java.version>
		<commonmark.version>0.22.0</commonmark.version>
		<lombok.version>1.18.42</lombok.version>
		<spring-modulith.version>2.0.9</spring-modulith.version>
		<!-- Saúde do código (scripts/saude.ps1). Versões conferidas no Maven Central em 2026-11-10 -->
		<archunit.version>1.5.1</archunit.version>
		<pmd-plugin.version>3.28.0</pmd-plugin.version>
		<pmd.version>7.29.0</pmd.version>
		<spotbugs-plugin.version>4.10.5.0</spotbugs-plugin.version>
		<findsecbugs.version>1.14.0</findsecbugs.version>
		<jacoco.version>0.8.16</jacoco.version>
		<!-- true: PMD (prioridade 1-2) e SpotBugs quebram o build. false: só mede (relatório) -->
		<saude.bloqueia>true</saude.bloqueia>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.modulith</groupId>
				<artifactId>spring-modulith-bom</artifactId>
				<version>${spring-modulith.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!--
			  Versões corrigidas de dependências indiretas com falha conhecida (OSV, 2026-11-10). Vêm pelo SDK do Resend
			  (já na última versão): okio 3.2.0 e org.json 20250517 tinham vulnerabilidades. Remover quando o SDK
			  trouxer versões novas sozinho (scripts/saude.ps1 avisa).
			-->
			<dependency>
				<groupId>com.squareup.okio</groupId>
				<artifactId>okio</artifactId>
				<version>3.18.2</version>
			</dependency>
			<dependency>
				<groupId>com.squareup.okio</groupId>
				<artifactId>okio-jvm</artifactId>
				<version>3.18.2</version>
			</dependency>
			<dependency>
				<groupId>org.json</groupId>
				<artifactId>json</artifactId>
				<version>20260814</version>
			</dependency>
			<!--
			  OpenTelemetry vem pelo SDK do Claude (anthropic-java 3.8.0 traz 1.55.0, com GHSA-ccrj-gw8r-854m e
			  GHSA-rcgg-9c38-7xpx; corrigidas em 1.67.0 e 1.62.0). OSV, 2026-11-11.
			-->
			<dependency>
				<groupId>io.opentelemetry</groupId>
				<artifactId>opentelemetry-bom</artifactId>
				<version>1.68.0</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Web -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Modularidade (ADR-001) -->
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-starter-core</artifactId>
		</dependency>

		<!-- Persistência (ADR-002) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- Segurança -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-client</artifactId>
		</dependency>
		<dependency>
			<groupId>com.auth0</groupId>
			<artifactId>java-jwt</artifactId>
			<version>4.4.0</version>
		</dependency>
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j-core</artifactId>
			<version>8.10.1</version>
		</dependency>
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>

		<!-- Integrações -->
		<dependency>
			<groupId>com.resend</groupId>
			<artifactId>resend-java</artifactId>
			<version>4.11.0</version>
		</dependency>
		<!-- SDK oficial do Claude: só é usado com booksmith.ai.provider=anthropic (Maven Central, com.anthropic) -->
		<dependency>
			<groupId>com.anthropic</groupId>
			<artifactId>anthropic-java</artifactId>
			<version>3.8.0</version>
		</dependency>
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
			<version>2.34.0</version>
		</dependency>

		<!-- Exportação: PDF de leitura (HTML + CSS → PDF, em processo; §13 da arquitetura) -->
		<dependency>
			<groupId>io.github.openhtmltopdf</groupId>
			<artifactId>openhtmltopdf-pdfbox</artifactId>
			<version>1.1.100</version>
		</dependency>
		<!-- Importação de Markdown (.md) -->
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark</artifactId>
			<version>${commonmark.version}</version>
		</dependency>
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark-ext-gfm-strikethrough</artifactId>
			<version>${commonmark.version}</version>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${lombok.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- Testes -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!-- Regras de arquitetura além das fronteiras do Modulith (camadas, nomes, dependências) -->
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Valida o ePub gerado nos testes, como as lojas fazem -->
		<dependency>
			<groupId>org.w3c</groupId>
			<artifactId>epubcheck</artifactId>
			<version>5.4.0</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<!-- Cobertura dos testes: target/site/jacoco/index.html -->
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>agente</id>
						<goals><goal>prepare-agent</goal></goals>
					</execution>
					<execution>
						<id>relatorio</id>
						<phase>verify</phase>
						<goals><goal>report</goal></goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- Verbosidade, complexidade, código morto e duplicado (config/pmd-ruleset.xml) -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>${pmd-plugin.version}</version>
				<dependencies>
					<dependency>
						<groupId>net.sourceforge.pmd</groupId>
						<artifactId>pmd-java</artifactId>
						<version>${pmd.version}</version>
					</dependency>
					<dependency>
						<groupId>net.sourceforge.pmd</groupId>
						<artifactId>pmd-core</artifactId>
						<version>${pmd.version}</version>
					</dependency>
				</dependencies>
				<configuration>
					<targetJdk>${java.version}</targetJdk>
					<rulesets><ruleset>config/pmd-ruleset.xml</ruleset></rulesets>
					<includeTests>false</includeTests>
					<minimumTokens>100</minimumTokens>
					<printFailingErrors>true</printFailingErrors>
					<failOnViolation>${saude.bloqueia}</failOnViolation>
					<!-- só prioridade 1 e 2 quebram o build; complexidade (3) vai para o relatório -->
					<failurePriority>2</failurePriority>
					<excludeRoots><excludeRoot>target/generated-sources</excludeRoot></excludeRoots>
				</configuration>
				<executions>
					<execution>
						<phase>verify</phase>
						<goals><goal>check</goal><goal>cpd-check</goal></goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- Bugs e falhas de segurança no bytecode: SpotBugs + Find Security Bugs (OWASP) -->
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>${spotbugs-plugin.version}</version>
				<configuration>
					<effort>Max</effort>
					<threshold>Medium</threshold>
					<excludeFilterFile>config/spotbugs-exclude.xml</excludeFilterFile>
					<failOnError>${saude.bloqueia}</failOnError>
					<xmlOutput>true</xmlOutput>
					<plugins>
						<plugin>
							<groupId>com.h3xstream.findsecbugs</groupId>
							<artifactId>findsecbugs-plugin</artifactId>
							<version>${findsecbugs.version}</version>
						</plugin>
					</plugins>
				</configuration>
				<executions>
					<execution>
						<phase>verify</phase>
						<goals><goal>check</goal></goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
