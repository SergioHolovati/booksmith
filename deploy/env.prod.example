# Segredos de PRODUÇÃO do Booksmith. Vive só em /opt/booksmith/.env no servidor (dono root, chmod 600) e numa cópia
# no seu gerenciador de senhas. NUNCA no Git. Gere cada valor na hora:  openssl rand -base64 32
# (no Windows: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }) -as [byte[]]))

# ---- Endereço ----
# Domínio do site (sem https://). No mês de teste, o nome que a Hostinger dá ao VPS (srvNNNNNN.hstgr.cloud).
SITE_ADDRESS=
# E-mail que o Let's Encrypt usa para avisar sobre o certificado
ACME_EMAIL=

# ---- Segredos da API ----
JWT_SECRET=
CRYPTO_KEY=

# ---- Bancos e armazenamento (senhas geradas; os nomes podem ficar) ----
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=booksmith
MINIO_ROOT_PASSWORD=
MEDIA_BUCKET=booksmith-media

# ---- Google (credencial OAuth DE PRODUÇÃO, outra que a de desenvolvimento) ----
# Redirecionamentos a cadastrar no Google Cloud: https://<SITE_ADDRESS>/login/oauth2/code/google
#                                                 https://<SITE_ADDRESS>/oauth2/drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- IA ----
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=3

# ---- Ilustrações com IA (FLUX, Black Forest Labs; https://dashboard.bfl.ai) ----
BFL_API_KEY=
# Ilustrações por pessoa em 7 dias
ILLUSTRATIONS_WEEKLY_LIMIT=3

# ---- E-mail (Resend) ----
MAIL_ENABLED=true
RESEND_API_KEY=
# Enquanto o domínio não está verificado no Resend: Booksmith <onboarding@resend.dev>
MAIL_FROM=Booksmith <no-reply@booksmith.com.br>
# Quem recebe os alertas de segurança
ALERT_EMAIL=
# Quem recebe o aviso de pedido novo de suporte (vazio: o mesmo ALERT_EMAIL)
SUPPORT_TEAM_EMAIL=
# Domínio do backoffice da equipe (padrão: adminbooksmith.com.br). O DNS aponta para este servidor, como o do app.
ADMIN_ADDRESS=adminbooksmith.com.br
# Equipe do backoffice: só e-mails destes domínios entram (separados por vírgula)
STAFF_EMAIL_DOMAINS=booksmith.com.br
# A primeira conta da equipe (administrador): com a equipe vazia, a API manda o convite para este e-mail ao subir
STAFF_BOOTSTRAP_EMAIL=

# ---- Regras do beta ----
INVITE_REQUIRED=true
MFA_REQUIRED=true
TERMS_VERSION=2026-11-13
PDF_PER_DAY=2
COVER_PDF_PER_DAY=5

# ---- Cópia dos backups fora do servidor (Cloudflare R2) ----
# Chave PÚBLICA do age (a privada fica só com você, nunca no servidor)
AGE_RECIPIENT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<id-da-conta>.r2.cloudflarestorage.com
R2_BUCKET=booksmith-backups
# Opcional: URL de heartbeat (Healthchecks.io ou UptimeRobot) avisada a cada envio que deu certo
BACKUP_HEARTBEAT_URL=
