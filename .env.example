# Copie para .env (o .env está no .gitignore). Nunca versione valores reais.

# Login com Google (console.cloud.google.com > APIs e serviços > Credenciais)
# URI de redirecionamento autorizada em dev: http://localhost:8090/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Obrigatório fora do perfil dev. Gere com: openssl rand -base64 48
# JWT_SECRET=

# E-mail (em dev fica desligado e o conteúdo vai para o log)
# MAIL_ENABLED=true
# RESEND_API_KEY=

# FRONTEND_URL=http://localhost:4200

# Limites por IP (em dev já são folgados para os testes de integração)
# RATE_LIMIT_GENERAL_PER_MINUTE=300
# RATE_LIMIT_AUTH_PER_MINUTE=20

# IA (§4.11): ollama (local), anthropic (API do Claude) ou off. A chave da Anthropic nunca vai para o git.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# AI_DAILY_LIMIT=40

# Chave (32 bytes em base64) que criptografa segredos no banco (MFA, Google Drive). Em produção, obrigatória:
#   openssl rand -base64 32
# CRYPTO_KEY=

# Beta fechado: criar conta exige código de convite (padrão true). Desligue quando abrir para todos.
# INVITE_REQUIRED=true

# Verificação em duas etapas obrigatória para todas as contas (padrão true).
# MFA_REQUIRED=true

# Limites diários de PDF por pessoa (padrão 2 do livro e 5 da capa).
# PDF_PER_DAY=2
# COVER_PDF_PER_DAY=5

# E-mail do administrador que recebe os alertas de segurança (picos de bloqueio, 429, erros 500, MFA errado). Vazio: só o log.
# ALERT_EMAIL=

# Versão em vigor dos termos (data). Mudou o texto das páginas /termos e /privacidade? Troque aqui: todo mundo aceita de novo.
# TERMS_VERSION=2026-11-13
