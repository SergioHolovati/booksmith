# Copie para .env (o .env está no .gitignore). Nunca versione valores reais.

# Login com Google (console.cloud.google.com > APIs e serviços > Credenciais)
# URI de redirecionamento autorizada em dev: http://localhost:8090/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Obrigatório fora do perfil dev. Gere com: openssl rand -base64 48
# JWT_SECRET=

# E-mail (em dev fica desligado e o conteúdo vai para o log)
# MAIL_ENABLED=true
# RESEND_API_KEY=

# FRONTEND_URL=http://localhost:4200

# Limites por IP (em dev já são folgados para os testes de integração)
# RATE_LIMIT_GENERAL_PER_MINUTE=300
# RATE_LIMIT_AUTH_PER_MINUTE=20

# IA (§4.11): ollama (local), anthropic (API do Claude) ou off. A chave da Anthropic nunca vai para o git.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# AI_DAILY_LIMIT=40

# Chave (32 bytes em base64) que criptografa segredos no banco (MFA, Google Drive). Em produção, obrigatória:
#   openssl rand -base64 32
# CRYPTO_KEY=
